# Site (production: https://celpiplib.com — required for Google OAuth on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI / media generation
ANTHROPIC_API_KEY=
# Speaking images: stability (default) or fal (Flux)
SPEAKING_IMAGE_PROVIDER=fal
# If fal billing is locked, auto-falls back to Stability when STABILITY_API_KEY is set
SPEAKING_IMAGE_FAL_FALLBACK=true
STABILITY_API_KEY=
FAL_KEY=
# Optional: defaults to fal-ai/flux-pro/v1.1
# FAL_FLUX_MODEL=fal-ai/flux-2-pro
GOOGLE_TTS_API_KEY=

# Supabase Auth (Google OAuth): add these exact URLs under Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3000/api/auth/callback
#   http://localhost:3000/auth/callback
#   https://celpiplib.com/api/auth/callback
#   https://celpiplib.com/auth/callback
#   https://www.celpiplib.com/api/auth/callback
#   https://www.celpiplib.com/auth/callback
# Site URL in Supabase should match NEXT_PUBLIC_SITE_URL (e.g. https://celpiplib.com)

# Optional: skip vision checks during local image pipeline debugging
# SPEAKING_SKIP_TASK34_ACTIVITY_CHECK=true
# SPEAKING_SKIP_TASK5_IMAGE_CHECK=true
# SPEAKING_SKIP_TASK8_IMAGE_CHECK=true
