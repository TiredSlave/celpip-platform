# Site (production: https://www.celpiplib.com — apex celpiplib.com redirects to www)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Recommended on Vercel: service_role key from Supabase → Settings → API (bypasses RLS for admin APIs).
# Local: can leave empty if you ran docs/supabase-mock-tests-rls.sql
SUPABASE_SERVICE_ROLE_KEY=

# AI / media generation
ANTHROPIC_API_KEY=
# Speaking images: stability (default) or fal (Flux)
SPEAKING_IMAGE_PROVIDER=fal
# If fal billing is locked, auto-falls back to Stability when STABILITY_API_KEY is set
SPEAKING_IMAGE_FAL_FALLBACK=true
STABILITY_API_KEY=
FAL_KEY=
# Optional: defaults to fal-ai/flux-pro/v1.1
# FAL_FLUX_MODEL=fal-ai/flux-2-pro
GOOGLE_TTS_API_KEY=

# Site URL in Supabase should match production (https://www.celpiplib.com).
# In Supabase → Redirect URLs: ONE URL PER ROW (never space-separate on one line).
#   http://localhost:3000/auth/callback
#   http://127.0.0.1:3000/auth/callback   (optional; code normalizes to localhost)
#   http://localhost:3000/**              (wildcard also works)
#   https://www.celpiplib.com/auth/callback
#   https://celpiplib.com/auth/callback
# If localhost is missing, Supabase falls back to Site URL (celpiplib.com) after OAuth.
# Do NOT set Production NEXT_PUBLIC_SITE_URL to http://localhost:3000 on Vercel.

# Optional: skip vision checks during local image pipeline debugging
# SPEAKING_SKIP_TASK34_ACTIVITY_CHECK=true
# SPEAKING_SKIP_TASK5_IMAGE_CHECK=true
# SPEAKING_SKIP_TASK8_IMAGE_CHECK=true
